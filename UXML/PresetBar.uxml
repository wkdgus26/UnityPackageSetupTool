<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <engine:ScrollView name="PresetBarScroll" horizontal-scroller-visibility="Hidden" class="preset-bar">
        <engine:VisualElement name="PresetTabRow" class="preset-bar__row">
            <engine:Button name="AddPresetButton" text="+" class="preset-bar__add" />
        </engine:VisualElement>
    </engine:ScrollView>
</engine:UXML>
