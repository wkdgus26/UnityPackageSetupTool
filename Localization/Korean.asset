  - key: import.reason.timeout
    text: "{0}\uBD84 \uB3D9\uC548 \uC784\uD3EC\uD2B8 \uC644\uB8CC \uC774\uBCA4\uD2B8\uAC00 \uC5C6\uC74C"
  - key: import.alreadyImported
    text: "\uC774\uBBF8 \uC784\uD3EC\uD2B8\uB428"
  - key: import.noLocalFile
    text: "\uB85C\uCEEC \uD30C\uC77C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4(\uB2E4\uC6B4\uB85C\uB4DC\uB418\uC9C0 \uC54A\uC74C)."
