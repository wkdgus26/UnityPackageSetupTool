  - key: import.unreadable
    text: "\uD655\uC778 \uBD88\uAC00: \uD328\uD0A4\uC9C0 \uD30C\uC77C\uC744 \uC77D\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4({0}) ({1})"
  - key: import.noAssetList
    text: "\uD655\uC778 \uBD88\uAC00: \uD328\uD0A4\uC9C0\uC5D0\uC11C \uC5D0\uC14B \uBAA9\uB85D\uC744 \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4 ({0})"
