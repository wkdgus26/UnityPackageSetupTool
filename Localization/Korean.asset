  - key: preset.nameRequired
    text: "\uD504\uB9AC\uC14B \uC774\uB984\uC744 \uC785\uB825\uD558\uC138\uC694."
  - key: preset.invalidNameChars
    text: "\uD504\uB9AC\uC14B \uC774\uB984\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB294 \uBB38\uC790\uAC00 \uC788\uC2B5\uB2C8\uB2E4: {0}"
  - key: presetFile.empty
    text: "\uD30C\uC77C\uC774 \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
  - key: presetFile.invalidJson
    text: "JSON \uD615\uC2DD \uC624\uB958: {0}"
  - key: presetFile.unknownType
    text: "{0}\uBC88 \uD56D\uBAA9: \uC54C \uC218 \uC5C6\uB294 type {1}"
  - key: presetFile.emptyId
    text: "{0}\uBC88 \uD56D\uBAA9: id \uAC00 \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
  - key: presetFile.emptyDisplayName
    text: "{0}\uBC88 \uD56D\uBAA9({1}): displayName \uC774 \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
  - key: presetFile.duplicateItem
    text: "\uAC19\uC740 \uD56D\uBAA9\uC774 \uC5EC\uB7EC \uBC88 \uC788\uC2B5\uB2C8\uB2E4: {0} {1}"
  - key: ui.refresh.tooltip
    text: "\uD328\uD0A4\uC9C0 \uBAA9\uB85D \uAC31\uC2E0: Registry \uC804\uCCB4, Asset Store \uAD6C\uB9E4 \uBAA9\uB85D, \uC124\uCE58\uB41C Git \uD328\uD0A4\uC9C0\uB97C \uBAA9\uB85D\uC5D0 \uCD94\uAC00\xB7\uAC31\uC2E0\uD569\uB2C8\uB2E4. \uD504\uB9AC\uC14B\uC740 \uBC14\uB00C\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - key: ui.registerInstalled
    text: "\uC124\uCE58\uB41C \uD328\uD0A4\uC9C0 \uB4F1\uB85D"
  - key: ui.registerInstalled.tooltip
    text: "\uD604\uC7AC \uD504\uB85C\uC81D\uD2B8\uC5D0 \uC124\uCE58\uB41C \uD328\uD0A4\uC9C0\uB97C \uCC3E\uC544, \uC120\uD0DD\uB41C \uD504\uB9AC\uC14B\uC5D0 \uB4F1\uB85D\uD560 \uAC83\uC744 \uCC3D\uC5D0\uC11C \uACE0\uB985\uB2C8\uB2E4(\uCD94\uAC00\uB9CC). \uB2E4\uB978 \uD504\uB85C\uC81D\uD2B8\uC5D0\uC11C \uAC19\uC740 \uBC29\uBC95\uC73C\uB85C \uC124\uCE58\uD560 \uC218 \uC5C6\uB294 \uD328\uD0A4\uC9C0(\uB0B4\uC7A5 \uBAA8\uB4C8, \uC5D0\uB514\uD130\uC5D0 \uD3EC\uD568\uB41C \uD328\uD0A4\uC9C0(\uCD9C\uCC98 BuiltIn), \uB85C\uCEEC \uD328\uD0A4\uC9C0)\uB294 \uC81C\uC678\uD569\uB2C8\uB2E4. Asset Store \uC5D0\uC14B\uC740 \uBAA9\uB85D\uC5D0 \uC788\uB294 \uAD6C\uB9E4 \uD56D\uBAA9 \uC911 \uC784\uD3EC\uD2B8\uB41C \uAC83\uB9CC \uBCF4\uC5EC\uC90D\uB2C8\uB2E4."
  - key: log.playModeBlockedByRegister
    text: "\uC124\uCE58\uB41C \uD328\uD0A4\uC9C0 \uB4F1\uB85D \uC911\uC5D0\uB294 Play Mode\uC5D0 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB05D\uB09C \uB4A4 \uB2E4\uC2DC \uC2E4\uD589\uD558\uC138\uC694."
  - key: progress.registerInterrupted
    text: "\uC124\uCE58\uB41C \uD328\uD0A4\uC9C0 \uB4F1\uB85D\uC774 \uC2A4\uD06C\uB9BD\uD2B8 \uB9AC\uB85C\uB4DC\uB85C \uC911\uB2E8\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC2E4\uD589\uD558\uC138\uC694."
  - key: progress.registerFinished
    text: "\uC124\uCE58\uB41C \uD328\uD0A4\uC9C0 \uB4F1\uB85D \uC644\uB8CC: '{0}'\uC5D0 {1}\uAC1C \uCD94\uAC00"
  - key: register.result
    text: "{0}: {1}\uAC1C \uB4F1\uB85D, \uC774\uBBF8 \uB4F1\uB85D\uB428 {2}\uAC1C, \uC120\uD0DD \uC548 \uD568 {3}\uAC1C, \uC81C\uC678 {4}\uAC1C"
  - key: register.assetStoreNoPurchases
    text: "MyAssets: \uBAA9\uB85D\uC5D0 \uAD6C\uB9E4 \uD56D\uBAA9\uC774 \uC5C6\uC5B4 \uC784\uD3EC\uD2B8 \uC5EC\uBD80\uB97C \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uBAA9\uB85D \uAC31\uC2E0\uC744 \uBA3C\uC800 \uC2E4\uD589\uD558\uC138\uC694."
  - key: register.assetStoreSessionOnly
    text: "MyAssets: \uC774 Unity \uBC84\uC804\uC5D0\uC11C\uB294 \uC774\uC804 \uC138\uC158\uC758 \uC784\uD3EC\uD2B8 \uAE30\uB85D\uC744 \uC77D\uC744 \uC218 \uC5C6\uC5B4, \uC774\uBC88 \uC5D0\uB514\uD130 \uC138\uC158\uC5D0\uC11C \uC784\uD3EC\uD2B8\uD55C \uC5D0\uC14B\uB9CC \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
  - key: menu.changeSharedFolder
    text: "\uD3F4\uB354 \uBCC0\uACBD\u2026"
  - key: menu.openSharedFolder
    text: "\uD3F4\uB354 \uC5F4\uAE30"
  - key: dialog.changeSharedFolder.title
    text: "\uACF5\uC6A9 \uD3F4\uB354 \uC120\uD0DD"
  - key: dialog.copySharedData.title
    text: "\uACF5\uC6A9 \uD3F4\uB354 \uBCC0\uACBD"
  - key: dialog.copySharedData.message
    text: "\uC120\uD0DD\uD55C \uD3F4\uB354\uC5D0 \uD504\uB9AC\uC14B\uACFC \uD328\uD0A4\uC9C0 \uBAA9\uB85D\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uD604\uC7AC \uB370\uC774\uD130\uB97C \uBCF5\uC0AC\uD560\uAE4C\uC694?\n\n\uD604\uC7AC: {0}\n\uC0C8 \uD3F4\uB354: {1}"
  - key: dialog.copySharedData.ok
    text: "\uBCF5\uC0AC"
  - key: dialog.copySharedData.alt
    text: "\uBCF5\uC0AC\uD558\uC9C0 \uC54A\uC74C"
  - key: message.sharedFolderChanged
    text: "\uACF5\uC6A9 \uD3F4\uB354\uB97C \uBC14\uAFE8\uC2B5\uB2C8\uB2E4: {0}"
  - key: message.sharedFolderCopyFailed
    text: "\uB370\uC774\uD130\uB97C \uBCF5\uC0AC\uD558\uC9C0 \uBABB\uD574 \uACF5\uC6A9 \uD3F4\uB354\uB97C \uBC14\uAFB8\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4: {0}"
  - key: message.sharedFolderBusy
    text: "\uBAA9\uB85D \uAC31\uC2E0\xB7\uC124\uCE58\uB41C \uD328\uD0A4\uC9C0 \uB4F1\uB85D\xB7\uD504\uB9AC\uC14B \uC801\uC6A9 \uC911\uC5D0\uB294 \uACF5\uC6A9 \uD3F4\uB354\uB97C \uBC14\uAFC0 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: message.presetCreateFailed
    text: "\uD504\uB9AC\uC14B\uC744 \uB9CC\uB4E4\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4: {0}"
  - key: message.presetDeleteFailed
    text: "\uD504\uB9AC\uC14B\uC744 \uC0AD\uC81C\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4: {0}"
  - key: data.unreadableFile
    text: "\uC77D\uC744 \uC218 \uC5C6\uB294 \uD30C\uC77C\uC744 \uC81C\uC678\uD588\uC2B5\uB2C8\uB2E4: {0} - {1}"
  - key: data.catalogUnreadable
    text: "\uD328\uD0A4\uC9C0 \uBAA9\uB85D \uD30C\uC77C\uC744 \uC77D\uC744 \uC218 \uC5C6\uC5B4 \uBAA9\uB85D\uC744 \uBC14\uAFC0 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uD30C\uC77C\uC744 \uACE0\uCE58\uAC70\uB098 \uC9C0\uC6B0\uC138\uC694: {0} - {1}"
  - key: data.changedElsewhere
    text: "\uD504\uB9AC\uC14B '{0}'\uC774(\uAC00) \uB2E4\uB978 \uACF3\uC5D0\uC11C \uC0AD\uC81C\uB418\uC5C8\uAC70\uB098 \uC774\uB984\uC774 \uBC14\uB00C\uC5C8\uC2B5\uB2C8\uB2E4."
  - key: data.saveFailed
    text: "\uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4: {0} - {1}"
  - key: data.folderUnavailable
    text: "\uACF5\uC6A9 \uD3F4\uB354\uB97C \uC4F8 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4: {0} - {1}"
  - key: preset.nameTakenByUnreadable
    text: "\uACF5\uC6A9 \uD3F4\uB354\uC5D0 \uAC19\uC740 \uC774\uB984\uC758 \uC77D\uC744 \uC218 \uC5C6\uB294 \uD30C\uC77C\uC774 \uC788\uC2B5\uB2C8\uB2E4: {0}"
  - key: trash.unsupported
    text: "\uC774 OS\uC5D0\uC11C\uB294 \uD30C\uC77C\uC744 \uD734\uC9C0\uD1B5\uC73C\uB85C \uBCF4\uB0BC \uC218 \uC5C6\uC2B5\uB2C8\uB2E4: {0}"
  - key: trash.failed
    text: "\uD30C\uC77C\uC744 \uD734\uC9C0\uD1B5\uC73C\uB85C \uBCF4\uB0B4\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4: {0} ({1})"
  - key: progress.registerSaveFailed
    text: "\uC124\uCE58\uB41C \uD328\uD0A4\uC9C0\uB97C '{0}'\uC5D0 \uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  - key: ui.sharedFolder
    text: "\uACF5\uC6A9 \uD3F4\uB354"
  - key: ui.sharedFolder.tooltip
    text: "\uD504\uB9AC\uC14B\uACFC \uD328\uD0A4\uC9C0 \uBAA9\uB85D\uC744 \uC800\uC7A5\uD558\uB294 \uACF5\uC6A9 \uD3F4\uB354\uC785\uB2C8\uB2E4. \uAC19\uC740 PC\uC758 \uBAA8\uB4E0 \uD504\uB85C\uC81D\uD2B8\uAC00 \uD568\uAED8 \uC501\uB2C8\uB2E4.\n{0}"
  - key: dialog.applyPreset.summary
    text: "\uC0C8\uB85C \uC124\uCE58 {0}\uAC1C \xB7 \uC774\uBBF8 \uC124\uCE58\uB428 {1}\uAC1C"
  - key: dialog.badge.installed
    text: "\uC124\uCE58\uB428"
  - key: dialog.badge.imported
    text: "\uC784\uD3EC\uD2B8\uB428"
  - key: dialog.section.empty
    text: "\uC5C6\uC74C"
  - key: dialog.next
    text: "\uB2E4\uC74C"
  - key: dialog.reinstall.title
    text: "\uC774\uBBF8 \uC124\uCE58\uB41C \uD328\uD0A4\uC9C0"
  - key: dialog.reinstall.message
    text: "\uC774\uBBF8 \uC124\uCE58\uB41C \uD328\uD0A4\uC9C0\uAC00 {0}\uAC1C \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC124\uCE58\xB7\uC784\uD3EC\uD2B8\uD560 \uD56D\uBAA9\uC744 \uCCB4\uD06C\uD558\uC138\uC694.\n\uCCB4\uD06C\uD558\uC9C0 \uC54A\uC740 \uD56D\uBAA9\uC740 \uC774\uBC88 \uC801\uC6A9\uC5D0\uC11C \uC81C\uC678\uB429\uB2C8\uB2E4(\uD504\uB9AC\uC14B\uC740 \uBC14\uB00C\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4)."
  - key: dialog.reinstall.warning.unityRegistry
    text: "UnityRegistry: \uB2E4\uC2DC \uC694\uCCAD\uD558\uBA74 \uC5D0\uB514\uD130 \uAD8C\uC7A5 \uBC84\uC804\uC73C\uB85C \uBC14\uB014 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - key: dialog.reinstall.warning.myAssets
    text: "MyAssets: \uB2E4\uC2DC \uC784\uD3EC\uD2B8\uD558\uBA74 \uD504\uB85C\uC81D\uD2B8\uC5D0\uC11C \uACE0\uCE5C \uC5D0\uC14B \uD30C\uC77C\uC744 \uD328\uD0A4\uC9C0 \uB0B4\uC6A9\uC73C\uB85C \uB36E\uC5B4\uC501\uB2C8\uB2E4."
  - key: dialog.reinstall.warning.git
    text: "Git: \uB2E4\uC2DC \uC694\uCCAD\uD558\uBA74 \uC800\uC7A5\uC18C\uC758 \uCD5C\uC2E0 \uCEE4\uBC0B\uC73C\uB85C \uAC31\uC2E0\uB429\uB2C8\uB2E4."
  - key: dialog.reinstall.all
    text: "\uBAA8\uB450 \uC7AC\uC784\uD3EC\uD2B8"
  - key: dialog.reinstall.none
    text: "\uBAA8\uB450 \uC81C\uC678"
  - key: dialog.reinstall.summary
    text: "\uC7AC\uC784\uD3EC\uD2B8 {0}\uAC1C \xB7 \uC81C\uC678 {1}\uAC1C"
  - key: message.applyCancelled
    text: "'{0}' \uD504\uB9AC\uC14B \uC801\uC6A9\uC744 \uCDE8\uC18C\uD588\uC2B5\uB2C8\uB2E4."
  - key: progress.installCheckFailed
    text: "'{0}' \uD504\uB9AC\uC14B \uD56D\uBAA9\uC758 \uC124\uCE58 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uC9C0 \uBABB\uD574 \uC801\uC6A9\uC744 \uC2DC\uC791\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. {1}"
  - key: progress.installCheckInterrupted
    text: "\uC124\uCE58 \uC0C1\uD0DC \uD655\uC778\uC774 \uC2A4\uD06C\uB9BD\uD2B8 \uB9AC\uB85C\uB4DC\uB85C \uC911\uB2E8\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC801\uC6A9\uD558\uC138\uC694."
  - key: check.listFailed
    text: "\uD328\uD0A4\uC9C0 \uBAA9\uB85D \uC870\uD68C \uC2E4\uD328: {0}"
  - key: check.timeout
    text: "{0}\uBD84 \uC548\uC5D0 \uC751\uB2F5\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: check.assetStoreUnavailable
    text: "MyAssets \uC784\uD3EC\uD2B8 \uC5EC\uBD80\uB97C \uD655\uC778\uD560 \uC218 \uC5C6\uC5B4 \uBAA8\uB450 \uC0C8\uB85C \uC784\uD3EC\uD2B8\uD560 \uD56D\uBAA9\uC73C\uB85C \uD45C\uC2DC\uD569\uB2C8\uB2E4. {0}"
  - key: check.assetStoreSessionOnly
    text: "\uC774 Unity \uBC84\uC804\uC5D0\uC11C\uB294 \uC774\uC804 \uC138\uC158\uC5D0 \uC784\uD3EC\uD2B8\uD55C \uC5D0\uC14B\uC744 \uD655\uC778\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. '\uC784\uD3EC\uD2B8\uB428' \uD45C\uC2DC\uAC00 \uC5C6\uC5B4\uB3C4 \uC774\uBBF8 \uC784\uD3EC\uD2B8\uB41C \uC5D0\uC14B\uC740 \uB2E4\uC2DC \uC784\uD3EC\uD2B8\uB429\uB2C8\uB2E4."
  - key: log.playModeBlockedByInstallCheck
    text: "\uC124\uCE58 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uB294 \uC911\uC774\uB77C Play Mode \uC9C4\uC785\uC744 \uCDE8\uC18C\uD588\uC2B5\uB2C8\uB2E4."
  - key: apply.excluded
    text: "\uC0AC\uC6A9\uC790\uAC00 \uC81C\uC678\uD568"
  - key: upm.reinstalled
    text: "\uB2E4\uC2DC \uC694\uCCAD\uD568 \u2014 \uBC84\uC804 {0} \u2192 {1}"
  - key: upm.reinstalledSameVersion
    text: "\uB2E4\uC2DC \uC694\uCCAD\uD568 \u2014 \uBC84\uC804 \uADF8\uB300\uB85C {0}"
  - key: import.reimported
    text: "\uB2E4\uC2DC \uC784\uD3EC\uD2B8\uD568"
  - key: import.reimportUnverified
    text: "\uB2E4\uC2DC \uC784\uD3EC\uD2B8\uD588\uB294\uC9C0 \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4(\uC774\uBBF8 \uC784\uD3EC\uD2B8\uB41C \uC5D0\uC14B\uC774\uB77C \uAE30\uB85D\xB7\uD30C\uC77C\uB85C \uAD6C\uBD84\uD560 \uC218 \uC5C6\uC74C). {0}"
  - key: dialog.badge.update
    text: "\uC5C5\uB370\uC774\uD2B8 {0} \u2192 {1}"
  - key: dialog.badge.pinned
    text: "\uACE0\uC815\uB428 ({0})"
  - key: dialog.applyPreset.summaryWithUpdates
    text: "\uC0C8\uB85C \uC124\uCE58 {0}\uAC1C \xB7 \uC774\uBBF8 \uC124\uCE58\uB428 {1}\uAC1C (\uC5C5\uB370\uC774\uD2B8 \uAC00\uB2A5 {2}\uAC1C)"
  - key: dialog.reinstall.summaryWithUpdates
    text: "\uC7AC\uC784\uD3EC\uD2B8 {0}\uAC1C \xB7 \uC81C\uC678 {1}\uAC1C (\uC5C5\uB370\uC774\uD2B8 \uAC00\uB2A5 {2}\uAC1C)"
  - key: dialog.reinstall.updatesPreselected
    text: "\uC5C5\uB370\uC774\uD2B8\uAC00 \uC788\uB294 \uD56D\uBAA9\uC740 \uC7AC\uC784\uD3EC\uD2B8(\uC5C5\uB370\uC774\uD2B8)\uB85C \uBBF8\uB9AC \uCCB4\uD06C\uD574 \uB450\uC5C8\uC2B5\uB2C8\uB2E4."
  - key: check.update.assetStoreUnavailable
    text: "MyAssets \uC5C5\uB370\uC774\uD2B8\uB97C \uD655\uC778\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. {0}"
  - key: check.update.loginRequired
    text: "Unity \uACC4\uC815\uC5D0 \uB85C\uADF8\uC778\uD558\uC9C0 \uC54A\uC544 MyAssets \uC5C5\uB370\uC774\uD2B8\uB97C \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  - key: check.update.assetStoreFailed
    text: "MyAssets \uC5C5\uB370\uC774\uD2B8 \uD655\uC778 \uC2E4\uD328: {0}"
  - key: check.update.gitFailed
    text: "Git \uC5C5\uB370\uC774\uD2B8 \uD655\uC778 \uC2E4\uD328({0}): {1}"
  - key: check.update.timeoutSeconds
    text: "{0}\uCD08 \uC548\uC5D0 \uC751\uB2F5\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: git.notFound
    text: "git \uC744 \uC2E4\uD589\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4(\uC624\uB958 {0}). git \uC774 \uC124\uCE58\uB3FC \uC788\uACE0 PATH \uC5D0 \uC788\uB294\uC9C0 \uD655\uC778\uD558\uC138\uC694."
  - key: git.exitCode
    text: "git \uC774 \uC624\uB958\uB85C \uB05D\uB0AC\uC2B5\uB2C8\uB2E4(\uCF54\uB4DC {0}): {1}"
  - key: git.refNotFound
    text: "\uC6D0\uACA9 \uC800\uC7A5\uC18C\uC5D0 '{0}' \uC774(\uAC00) \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: download.refreshed
    text: "\uCD5C\uC2E0 \uBC84\uC804 \uBC1B\uC74C {0} \u2192 {1}"
  - key: check.update.registryOffline
    text: "\uC628\uB77C\uC778 \uD328\uD0A4\uC9C0 \uBAA9\uB85D\uC744 \uBC1B\uC9C0 \uBABB\uD574 \uB85C\uCEEC \uCE90\uC2DC\uB85C \uD310\uC815\uD588\uC2B5\uB2C8\uB2E4(UnityRegistry \uC5C5\uB370\uC774\uD2B8\uAC00 \uBE60\uC9C8 \uC218 \uC788\uC74C): {0}"
  - key: download.refreshNotUpdated
    text: "\uBC1B\uAE30\uB294 \uB05D\uB0AC\uC9C0\uB9CC \uB85C\uCEEC \uD30C\uC77C\uC774 \uCD5C\uC2E0 \uBC84\uC804\uC73C\uB85C \uBC14\uB00C\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - key: import.notLatest
    text: "\uCD5C\uC2E0 \uBC84\uC804\uC744 \uBC1B\uC9C0 \uBABB\uD574 \uC784\uD3EC\uD2B8\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4(\uC608\uC804 \uBC84\uC804\uC73C\uB85C \uB36E\uC5B4\uC4F0\uC9C0 \uC54A\uC74C)."
  - key: progress.gitUrlCheckInterrupted
    text: "git URL \uD655\uC778\uC774 \uC2A4\uD06C\uB9BD\uD2B8 \uB9AC\uB85C\uB4DC\uB85C \uC911\uB2E8\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uCD94\uAC00\uD558\uC138\uC694."
  - key: log.playModeBlockedByGitUrlCheck
    text: "git URL\uC744 \uD655\uC778\uD558\uB294 \uC911\uC774\uB77C Play Mode \uC9C4\uC785\uC744 \uCDE8\uC18C\uD588\uC2B5\uB2C8\uB2E4."
  - key: message.gitUrlInvalid
    text: "git URL\uC744 \uCD94\uAC00\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4: {0}\n{1}"
  - key: message.gitUrlAddedWithName
    text: "git URL\uC744 \uCD94\uAC00\uD558\uACE0 '{0}'\uC5D0 \uCCB4\uD06C\uD588\uC2B5\uB2C8\uB2E4: {1} (\uD328\uD0A4\uC9C0 {2})"
  - key: message.gitUrlAddedUnverified
    text: "git URL\uC744 \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uC9C0\uB9CC \uCD94\uAC00\uD558\uACE0 '{0}'\uC5D0 \uCCB4\uD06C\uD588\uC2B5\uB2C8\uB2E4: {1}\n{2}"
  - key: gitCheck.notGitUrl
    text: "UPM\uC774 git URL\uB85C \uC778\uC2DD\uD558\uC9C0 \uC54A\uB294 \uD615\uC2DD\uC785\uB2C8\uB2E4. \uC800\uC7A5\uC18C \uC8FC\uC18C\uAC00 .git\uC73C\uB85C \uB05D\uB098\uAC70\uB098 git+\uB85C \uC2DC\uC791\uD574\uC57C \uD569\uB2C8\uB2E4."
  - key: gitCheck.repositoryNotFound
    text: "\uC800\uC7A5\uC18C\uB97C \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4(\uC8FC\uC18C\uAC00 \uD2C0\uB838\uAC70\uB098 \uC811\uADFC \uAD8C\uD55C\uC774 \uC5C6\uC74C): {0}"
  - key: gitCheck.revisionNotFound
    text: "\uB9AC\uBE44\uC804 '{0}'\uC774(\uAC00) \uC800\uC7A5\uC18C\uC5D0 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: gitCheck.shortCommit
    text: "\uC9E7\uC740 \uCEE4\uBC0B \uD574\uC2DC('{0}')\uB294 \uC124\uCE58\uD558\uC9C0 \uC54A\uACE0 \uD655\uC778\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: gitCheck.noManifest
    text: "\uC800\uC7A5\uC18C\uC5D0 UPM \uD328\uD0A4\uC9C0(package.json)\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: gitCheck.manifestNotAtPath
    text: "'{0}'\uC5D0 package.json\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. \uC800\uC7A5\uC18C\uC5D0\uC11C \uCC3E\uC740 \uD328\uD0A4\uC9C0\uC758 URL:\n{1}"
  - key: gitCheck.candidatesWithMore
    text: "{0}\n\uC678 {1}\uAC1C"
  - key: gitCheck.invalidManifest
    text: "package.json\uC744 \uC77D\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4: {0}"
  - key: gitCheck.manifestMissingFields
    text: "package.json\uC5D0 name \uB610\uB294 version\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: applyProgress.title
    text: "\uC644\uB8CC {0} / {1} ({2}%)"
  - key: applyProgress.counts
    text: "\uC131\uACF5 {0} \xB7 \uAC74\uB108\uB700 {1} \xB7 \uC2E4\uD328 {2} \xB7 \uD655\uC778 \uD544\uC694 {3}  |  \uB85C\uB4DC \uC911 {4} \xB7 \uB300\uAE30 {5}"
