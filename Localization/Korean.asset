    text: "\uC124\uCE58 \uD655\uC778 \uC911"
  - key: applyItem.activity.downloading
    text: "\uB2E4\uC6B4\uB85C\uB4DC \uC911"
  - key: applyItem.activity.importing
    text: "\uC784\uD3EC\uD2B8 \uC911"
