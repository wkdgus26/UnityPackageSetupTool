  - key: package.tarHeaderUnreadable
    text: "\uD328\uD0A4\uC9C0\uC758 tar \uD5E4\uB354\uB97C \uC77D\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
