  - key: ui.section.selected
    text: "\uC120\uD0DD\uB428 {0}"
  - key: ui.section.unselected
    text: "\uC120\uD0DD \uC548 \uB428 {0}"
  - key: ui.empty.noSearchMatch
    text: "\uAC80\uC0C9\uC5B4\uC640 \uC77C\uCE58\uD558\uB294 \uD56D\uBAA9\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: ui.empty.git
    text: "\uD56D\uBAA9\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. \uC704 \uC785\uB825\uB780\uC5D0 git URL\uC744 \uCD94\uAC00\uD558\uAC70\uB098 \uBAA9\uB85D \uAC31\uC2E0 \uBC84\uD2BC\uC744 \uB204\uB974\uC138\uC694."
  - key: ui.empty.default
    text: "\uD56D\uBAA9\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. \uBAA9\uB85D \uAC31\uC2E0 \uBC84\uD2BC\uC744 \uB204\uB974\uC138\uC694."
  - key: menu.rename
    text: "\uC774\uB984 \uBCC0\uACBD"
  - key: menu.delete
    text: "\uC0AD\uC81C..."
  - key: dialog.cancel
    text: "\uCDE8\uC18C"
  - key: dialog.deletePreset.title
    text: "\uD504\uB9AC\uC14B \uC0AD\uC81C"
  - key: dialog.deletePreset.message
    text: "'{0}' \uD504\uB9AC\uC14B\uC744 \uC0AD\uC81C\uD560\uAE4C\uC694?\n(\uD734\uC9C0\uD1B5\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4)"
  - key: dialog.deletePreset.ok
    text: "\uC0AD\uC81C"
  - key: dialog.applyPreset.title
    text: "\uD504\uB9AC\uC14B \uC801\uC6A9"
  - key: dialog.applyPreset.message
    text: "'{0}' \uD504\uB9AC\uC14B\uC758 \uD328\uD0A4\uC9C0 {1}\uAC1C\uB97C \uC774 \uD504\uB85C\uC81D\uD2B8\uC5D0 \uC801\uC6A9\uD569\uB2C8\uB2E4. \uC9C4\uD589 \uC911 \uC2A4\uD06C\uB9BD\uD2B8\uAC00 \uB2E4\uC2DC \uCEF4\uD30C\uC77C\uB418\uC5B4\uB3C4 \uC774\uC5B4\uC11C \uC9C4\uD589\uD569\uB2C8\uB2E4."
  - key: dialog.applyPreset.ok
    text: "\uC801\uC6A9"
  - key: message.playModeUnavailable
    text: "Play Mode\uC5D0\uC11C\uB294 \uBAA9\uB85D \uAC31\uC2E0, \uC124\uCE58\uB41C \uD328\uD0A4\uC9C0 \uB4F1\uB85D, \uD504\uB9AC\uC14B \uC801\uC6A9\uC744 \uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: message.presetCreated
    text: "\uD504\uB9AC\uC14B '{0}'\uC744 \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
  - key: message.presetRenameFailed
    text: "\uD504\uB9AC\uC14B \uC774\uB984 \uBCC0\uACBD \uC2E4\uD328: {0}"
  - key: message.presetRenamed
    text: "\uD504\uB9AC\uC14B \uC774\uB984\uC744 '{0}'\uC5D0\uC11C '{1}'(\uC73C)\uB85C \uBC14\uAFE8\uC2B5\uB2C8\uB2E4."
  - key: message.presetDeleted
    text: "\uD504\uB9AC\uC14B '{0}'\uC744 \uC0AD\uC81C\uD588\uC2B5\uB2C8\uB2E4."
  - key: message.gitUrlRequired
    text: "\uCD94\uAC00\uD560 git URL\uC744 \uC785\uB825\uD558\uC138\uC694."
  - key: message.gitUrlDuplicated
    text: "\uC774\uBBF8 \uBAA9\uB85D\uC5D0 \uC788\uB294 URL\uC785\uB2C8\uB2E4: {0}"
  - key: message.packageRemoved
    text: "\uBAA9\uB85D\uC5D0\uC11C \uC0AD\uC81C\uD588\uC2B5\uB2C8\uB2E4: {0}"
  - key: log.applyResumed
    text: "'{0}' \uC801\uC6A9\uC744 \uC774\uC5B4\uC11C \uC9C4\uD589\uD569\uB2C8\uB2E4: {1}"
  - key: log.playModeBlockedByCollect
    text: "\uBAA9\uB85D \uAC31\uC2E0 \uC911\uC5D0\uB294 Play Mode\uC5D0 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB05D\uB09C \uB4A4 \uB2E4\uC2DC \uC2E4\uD589\uD558\uC138\uC694."
  - key: log.playModeBlockedByApply
    text: "\uD504\uB9AC\uC14B \uC801\uC6A9 \uC911\uC5D0\uB294 Play Mode\uC5D0 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB05D\uB09C \uB4A4 \uB2E4\uC2DC \uC2E4\uD589\uD558\uC138\uC694."
  - key: log.packageHeaderUnreadable
    text: "\uC0C1\uD488 \uC815\uBCF4\uB97C \uC77D\uC9C0 \uBABB\uD574 \uAC74\uB108\uB701\uB2C8\uB2E4: {0} ({1})"
  - key: log.packageHeaderEmpty
    text: "\uC0C1\uD488 \uC815\uBCF4\uAC00 \uBE44\uC5B4 \uC788\uC5B4 \uAC74\uB108\uB701\uB2C8\uB2E4: {0}"
  - key: error.alreadyBusy
    text: "\uC774\uBBF8 \uC9C4\uD589 \uC911\uC778 \uC791\uC5C5\uC774 \uC788\uC2B5\uB2C8\uB2E4: {0}"
  - key: error.playModeStart
    text: "Play Mode\uC5D0\uC11C\uB294 \uBAA9\uB85D \uAC31\uC2E0, \uC124\uCE58\uB41C \uD328\uD0A4\uC9C0 \uB4F1\uB85D, \uD504\uB9AC\uC14B \uC801\uC6A9\uC744 \uC2DC\uC791\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: error.uxmlNotFound
    text: "UXML \uD30C\uC77C\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4: {0}"
  - key: progress.collectInterrupted
    text: "\uBAA9\uB85D \uAC31\uC2E0\uC774 \uC2A4\uD06C\uB9BD\uD2B8 \uB9AC\uB85C\uB4DC\uB85C \uC911\uB2E8\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC2E4\uD589\uD558\uC138\uC694."
