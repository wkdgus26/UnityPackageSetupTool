  - key: ui.installBadge.imported.tooltip
    text: "\uC774 \uD504\uB85C\uC81D\uD2B8\uC5D0 \uC784\uD3EC\uD2B8\uD55C \uAE30\uB85D\uC774 \uC788\uC2B5\uB2C8\uB2E4."
  - key: ui.installBadge.dependency
    text: "\uC124\uCE58\uB428(\uC758\uC874\uC131)"
